# ─────────────────────────────────────────────────────────────────────
# Famaash Chat Widget — environment
# Copy to `.env.local` for local dev (gitignored). VITE_* vars are inlined at
# build time. The REST base can also be overridden per-load via the URL query
# param ?api_base=<url> (handy for pointing a deployed build at staging).
# ─────────────────────────────────────────────────────────────────────

# REST base for the backend (config, token, uploads, e-sign, history).
VITE_WIDGET_API_BASE=https://api.catafleet.com/api/v1/widget
